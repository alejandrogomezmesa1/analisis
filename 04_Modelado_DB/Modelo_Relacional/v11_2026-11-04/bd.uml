// ============================================================================
// AGRUPACIONES (TABLEGROUPS) — 11 PROCESOS EN ORDEN DEL FLUJO DE TRABAJO
// Domiciliarios: sin tabla propia (usuario con rol Domiciliario).
// Dashboard: sin tablas propias (vistas y consultas de agregación).
// ============================================================================

// P1. Acceso y seguridad: Antes de operar: quién entra y con qué rol.
TableGroup P1_AccesoYSeguridad {
  roles
  usuarios
  accesos
  consentimientos
}

// P2. Configuración y calendario: Reglas del negocio y días hábiles que usan todos los procesos.
TableGroup P2_ConfiguracionYCalendario {
  configuraciones_sistema
  calendario
}

// P3. Abastecimiento: Insumos, proveedores y compras que alimentan el inventario.
TableGroup P3_Abastecimiento {
  categorias_insumos
  insumos
  proveedores
  proveedor_categorias
  compras
  compra_detalle
  movimientos_inventario
}

// P4. Catálogo de cocina: Platos, recetas (fichas técnicas) y tipos de coca.
TableGroup P4_CatalogoDeCocina {
  categorias_productos
  productos
  fichas_tecnicas
  ficha_tecnica_detalle
}

// P5. Oferta de planes: Planes que se venden (semanal, quincenal, mensual).
TableGroup P5_OfertaDePlanes {
  categorias_servicios
  servicios
}

// P6. Registro de clientes: El cliente, sus direcciones por día y sus juegos de cocas.
TableGroup P6_RegistroDeClientes {
  clientes
  direcciones_cliente
  direccion_dias
  juegos_cocas
  recipientes
}

// P7. Venta y pagos: Suscripción, comprobantes y pausas de entrega.
TableGroup P7_VentaYPagos {
  suscripciones
  pagos
  suspensiones_entrega
}

// P8. Menú semanal: Se publica el menú de la semana con alternativas por restricción.
TableGroup P8_MenuSemanal {
  menus_semana
  menus_diarios
  menu_items
}

// P9. Producción: Orden del día y líneas de producto terminado.
TableGroup P9_Produccion {
  ordenes_produccion
  producto_terminado
}

// P10. Despacho y rutas: Zonas, rutas del día, entregas y ubicación en tiempo real.
TableGroup P10_DespachoYRutas {
  zonas_cobertura
  rutas
  ruta_clientes
  geolocalizacion_domiciliarios
}

// P11. Incidencias: Novedades de la entrega y su solución.
TableGroup P11_Incidencias {
  incidencias
}
