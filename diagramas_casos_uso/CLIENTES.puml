@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "CLIENTES" {
  usecase "Gestión de clientes" as UC_Hub
  usecase "Listar clientes" as UC_Central
  usecase "Crear cliente" as UC_Create
  usecase "Filtrar / consultar clientes por nombre, documento, dirección, estado" as UC_Search
  usecase "Ver detalle del cliente" as UC_R1
  usecase "Editar cliente" as UC_R2
  usecase "Registrar dirección de entrega" as UC_R3
  usecase "Registrar modalidad de entrega" as UC_R4
  usecase "Registrar teléfono" as UC_R5
  usecase "Registrar correo electrónico" as UC_R6
  usecase "Registrar restricciones alimentarias" as UC_R7
  usecase "Registrar alergias alimentarias" as UC_R8
  usecase "Consultar suscripciones asociadas" as UC_R9
  usecase "Consultar historial de pagos" as UC_R10
  usecase "Generar reporte de clientes activos" as UC_R11
  usecase "Generar reporte por zona de cobertura" as UC_R12
  usecase "Generar reporte por tipo de plan" as UC_R13
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
UC_R7 -left-> UC_Central : <<extends>>
UC_R8 -left-> UC_Central : <<extends>>
UC_R9 -left-> UC_Central : <<extends>>
UC_R10 -left-> UC_Central : <<extends>>
UC_R11 -left-> UC_Central : <<extends>>
UC_R12 -left-> UC_Central : <<extends>>
UC_R13 -left-> UC_Central : <<extends>>
@enduml