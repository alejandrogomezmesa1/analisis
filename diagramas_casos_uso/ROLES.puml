@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "ROLES" {
  usecase "Gestión de roles" as UC_Hub
  usecase "Listar roles" as UC_Central
  usecase "Crear rol" as UC_Create
  usecase "Ver detalle del rol y permisos configurados" as UC_R1
  usecase "Editar  rol" as UC_R2
  usecase "Asignar permisos al rol" as UC_R3
  usecase "Cambiar estado del rol" as UC_R4
  usecase "Eliminar rol" as UC_R5
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
@enduml