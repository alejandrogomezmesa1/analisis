@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "PRODUCTO TERMINADO" {
  usecase "Gestión de producto terminado" as UC_Hub
  usecase "Listar productos terminados" as UC_Central
  usecase "Registrar producto terminado" as UC_Create
  usecase "Filtrar / consultar por fecha, producto, estado" as UC_Search
  usecase "Ver detalle del producto terminado" as UC_R1
  usecase "Registrar cantidad producida" as UC_R2
  usecase "Registrar fecha de elaboración" as UC_R3
  usecase "Asociar orden de producción" as UC_R4
  usecase "Generar reporte de producción diaria" as UC_R5
  usecase "Generar reporte de producción semanal" as UC_R6
  usecase "Generar reporte de producción mensual" as UC_R7
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
UC_R7 -left-> UC_Central : <<extends>>
@enduml