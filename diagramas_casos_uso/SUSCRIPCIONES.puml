  usecase "Seleccionar menú estándar" as UC_R8
  usecase "Seleccionar menú personalizado" as UC_R9
  usecase "Aplicar recargo por menú personalizado" as UC_R10
  usecase "Calcular fecha de inicio" as UC_R11
  usecase "Calcular fecha de vencimiento" as UC_R12
  usecase "Registrar comprobante de transferencia" as UC_R13
