@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "INSUMOS" {
  usecase "Gestión de insumos" as UC_Hub
  usecase "Listar insumos" as UC_Central
  usecase "Crear insumo" as UC_Create
  usecase "Filtrar / consultar insumos por nombre, categoría, proveedor, estado" as UC_Search
  usecase "Ver detalle del insumo" as UC_R1
  usecase "Editar insumo" as UC_R2
  usecase "Cambiar estado del insumo" as UC_R3
  usecase "Consultar movimientos de inventario" as UC_R4
  usecase "Consultar existencias" as UC_R5
  usecase "Consultar alertas de stock mínimo" as UC_R6
  usecase "Generar reporte de inventario" as UC_R7
  usecase "Generar reporte de consumo por período" as UC_R8
  usecase "Generar reporte de alertas de reabastecimiento" as UC_R9
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
UC_R7 -left-> UC_Central : <<extends>>
UC_R8 -left-> UC_Central : <<extends>>
UC_R9 -left-> UC_Central : <<extends>>
@enduml