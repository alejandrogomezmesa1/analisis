@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "PRODUCCION" {
  usecase "Gestión de produccion" as UC_Hub
  usecase "Listar órdenes de producción" as UC_Central
  usecase "Crear orden de producción" as UC_Create
  usecase "Filtrar / consultar órdenes por cantidad, fecha, restricciones y alergias" as UC_Search
  usecase "Ver detalle de orden de produccion" as UC_R1
  usecase "Editar orden de producción" as UC_R2
  usecase "Cambiar estado de orden de produccion" as UC_R3
  usecase "Consultar insumos requeridos" as UC_R4
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
@enduml