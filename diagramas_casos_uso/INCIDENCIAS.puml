@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "INCIDENCIAS" {
  usecase "Gestión de incidencias" as UC_Hub
  usecase "Listar incidencias" as UC_Central
  usecase "Registrar incidencia" as UC_Create
  usecase "Filtrar / consultar incidencias por tipo, cliente, domiciliario y estado" as UC_Search
  usecase "Ver detalle de incidencia" as UC_R1
  usecase "Gestionar incidencia" as UC_R2
  usecase "Dar solución a incidencia" as UC_R3
  usecase "Registrar respuesta al usuario" as UC_R4
  usecase "Consultar estado de solución" as UC_R5
  usecase "Gestionar suspensión de entrega" as UC_R6
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
@enduml