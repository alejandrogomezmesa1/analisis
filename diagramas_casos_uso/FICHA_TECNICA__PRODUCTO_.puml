@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "FICHA TECNICA PRODUCTO" {
  usecase "Gestión de fichas técnicas" as UC_Hub
  usecase "Listar fichas técnicas" as UC_Central
  usecase "Crear ficha técnica" as UC_Create
  usecase "Filtrar / consultar fichas por producto, insumo, estado" as UC_Search
  usecase "Ver detalle de ficha técnica" as UC_R1
  usecase "Editar ficha técnica" as UC_R2
  usecase "Cambiar estado de la ficha tecnica" as UC_R3
  usecase "Registrar insumos requeridos" as UC_R4
  usecase "Registrar cantidades exactas de insumos" as UC_R5
  usecase "Registrar tiempo estimado de preparación" as UC_R6
  usecase "Registrar procedimiento de elaboración" as UC_R7
  usecase "Registrar número de porciones" as UC_R8
  usecase "Consultar costo unitario estimado" as UC_R9
  usecase "Generar reporte de fichas técnicas" as UC_R10
  usecase "Generar reporte de costo unitario estimado" as UC_R11
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
UC_R7 -left-> UC_Central : <<extends>>
UC_R8 -left-> UC_Central : <<extends>>
UC_R9 -left-> UC_Central : <<extends>>
UC_R10 -left-> UC_Central : <<extends>>
UC_R11 -left-> UC_Central : <<extends>>
@enduml