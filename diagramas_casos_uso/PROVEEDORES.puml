@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "PROVEEDORES" {
  usecase "Gestión de proveedores" as UC_Hub
  usecase "Listar proveedores" as UC_Central
  usecase "Crear proveedor" as UC_Create
  usecase "Filtrar / consultar proveedores por nombre, documento, categoría, estado" as UC_Search
  usecase "Ver detalle del proveedor" as UC_R1
  usecase "Editar proveedor" as UC_R2
  usecase "Cambiar estado del proveedor" as UC_R3
  usecase "Consultar productos o insumos suministrados" as UC_R4
  usecase "Consultar historial de compras" as UC_R5
  usecase "Generar reporte de historial de compras" as UC_R6
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
@enduml