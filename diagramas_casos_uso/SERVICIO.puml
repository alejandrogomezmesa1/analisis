@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "SERVICIO" {
  usecase "Gestión de servicio" as UC_Hub
  usecase "Listar servicios" as UC_Central
  usecase "Crear servicio" as UC_Create
  usecase "Filtrar / consultar servicios por nombre, tipo, estado" as UC_Search
  usecase "Ver detalle del servicio" as UC_R1
  usecase "Editar servicio" as UC_R2
  usecase "Cambiar el estado del servicio" as UC_R3
  usecase "Registrar nombre del plan" as UC_R4
  usecase "Registrar tipo de plan" as UC_R5
  usecase "Registrar descripción" as UC_R6
  usecase "Registrar valor" as UC_R7
  usecase "Registrar duración en días" as UC_R8
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
UC_R7 -left-> UC_Central : <<extends>>
UC_R8 -left-> UC_Central : <<extends>>
@enduml