@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "MONITOREO DE ENTREGA TIEMPO REAL" {
  usecase "Monitoreo de entregas" as UC_Hub
  usecase "Listar ubicación de domiciliarios" as UC_Central
  usecase "Filtrar / consultar por ruta, domiciliario, fecha" as UC_Search
  usecase "Visualizar domiciliarios en mapa" as UC_R1
  usecase "Monitorear ubicación en tiempo real" as UC_R2
  usecase "Consultar avance de entregas" as UC_R3
  usecase "Consultar entregas por ruta" as UC_R4
  usecase "Consultar estado de rotación de cocas" as UC_R5
  usecase "Consultar registro de cocas recogidas" as UC_R6
  usecase "Generar reporte de entregas completadas" as UC_R7
  usecase "Generar reporte de entregas pendientes" as UC_R8
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
UC_R7 -left-> UC_Central : <<extends>>
UC_R8 -left-> UC_Central : <<extends>>
@enduml