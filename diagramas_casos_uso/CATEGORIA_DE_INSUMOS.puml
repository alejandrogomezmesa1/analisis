@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "CATEGORIA DE INSUMOS" {
  usecase "Gestión de categoria de insumos" as UC_Hub
  usecase "Listar categorías de insumos" as UC_Central
  usecase "Crear categoría de insumo" as UC_Create
  usecase "Filtrar / consultar categorías por nombre, estado" as UC_Search
  usecase "Ver detalle de la categoría" as UC_R1
  usecase "Editar categoría" as UC_R2
  usecase "Eliminar categoria de insumos" as UC_R3
  usecase "Cambiar estado de la categoría de insumos" as UC_R4
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
@enduml