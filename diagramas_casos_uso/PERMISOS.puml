@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "PERMISOS" {
  usecase "Gestión de permisos" as UC_Hub
  usecase "Listar permisos" as UC_Central
  usecase "Crear permiso" as UC_Create
  usecase "Ver detalle del permiso" as UC_R1
  usecase "Editar permiso" as UC_R2
  usecase "Cambiar estado del permiso" as UC_R3
  usecase "Eliminar permiso" as UC_R4
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
@enduml