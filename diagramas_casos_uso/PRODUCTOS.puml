@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "PRODUCTOS" {
  usecase "Gestión de productos" as UC_Hub
  usecase "Listar productos" as UC_Central
  usecase "Crear producto" as UC_Create
  usecase "Filtrar / consultar productos por nombre, categoría, estado" as UC_Search
  usecase "Ver detalle del producto" as UC_R1
  usecase "Editar producto" as UC_R2
  usecase "Cambiar estado del producto" as UC_R3
  usecase "Consultar insumos requeridos" as UC_R4
  usecase "Consultar especificaciones de preparación" as UC_R5
  usecase "Generar reporte de productos activos" as UC_R6
  usecase "Consultar costo unitario estimado" as UC_R7
}

admin -right-> UC_Hub
UC_Hub -right-> UC_Central : <<include>>
UC_Create -down-> UC_Hub : <<extends>>
UC_Create -down-> UC_Central : <<include>>
UC_Search -up-> UC_Hub : <<extends>>
UC_Search -up-> UC_Central : <<include>>
UC_R1 -left-> UC_Central : <<extends>>
UC_R2 -left-> UC_Central : <<extends>>
UC_R3 -left-> UC_Central : <<extends>>
UC_R4 -left-> UC_Central : <<extends>>
UC_R5 -left-> UC_Central : <<extends>>
UC_R6 -left-> UC_Central : <<extends>>
UC_R7 -left-> UC_Central : <<extends>>
@enduml