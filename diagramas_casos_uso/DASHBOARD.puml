@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60

actor "Admin" as admin

package "DASHBOARD" {
  usecase "Dashboard" as UC_Hub
  usecase "Exportar informes estratégicos" as UC_Create
  usecase "Filtrar / consultar información por rango de fechas, zona, plan" as UC_Search
  usecase "Consultar ingresos por tipo de plan" as UC_R1
  usecase "Consultar conversión por modalidad de venta" as UC_R2
  usecase "Consultar impacto del menú personalizado" as UC_R3
  usecase "Consultar estado de comprobantes de transferencia" as UC_R4
  usecase "Consultar proyección diaria de almuerzos" as UC_R5
  usecase "Consultar restricciones alimentarias" as UC_R6
  usecase "Consultar consumo de insumos" as UC_R7
  usecase "Consultar entregas completadas" as UC_R8
  usecase "Consultar entregas pendientes" as UC_R9
  usecase "Consultar desempeño de domiciliarios" as UC_R10
  usecase "Consultar inventario de cocas en rotación" as UC_R11
  usecase "Consultar incidencias de ruta" as UC_R12
  usecase "Consultar margen de rentabilidad por tipo de plan" as UC_R13
  usecase "Consultar tasa de retención de clientes" as UC_R14
  usecase "Consultar tasa de deserción de clientes" as UC_R15
  usecase "Consultar costo-beneficio logístico por zona" as UC_R16
  usecase "Consultar proyección de crecimiento" as UC_R17
  usecase "Consultar capacidad máxima de producción" as UC_R18
}

admin -right-> UC_Hub
UC_Create ..> UC_Hub : <<extends>>
UC_Search ..> UC_Hub : <<extends>>
